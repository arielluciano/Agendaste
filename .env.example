# Copiá este archivo como .env y completá los valores

# Google OAuth
GOOGLE_CLIENT_ID=tu_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
REDIRECT_URI=http://localhost:3000/auth/google/callback

# Mercado Pago (suscripciones — usar credenciales de prueba en desarrollo)
MP_PUBLIC_KEY=tu_public_key_aqui
MP_ACCESS_TOKEN=tu_access_token_aqui
# Secreto de firma del webhook — se obtiene en el panel de MP al crear/ver el webhook
# (Tus integraciones → la app → Webhooks → "Clave secreta"). Sin esto, el endpoint
# /api/subscriptions/webhook rechaza todas las notificaciones con 401.
MP_WEBHOOK_SECRET=tu_webhook_secret_aqui
# URL pública HTTPS de la app (MP exige back_url con HTTPS; en local usar un túnel tipo ngrok)
BASE_URL=https://tu-dominio-o-tunel.com

# Sesiones
SESSION_SECRET=una_clave_secreta_larga_cualquiera

# Resend (email de confirmación de turnos)
RESEND_API_KEY=tu_resend_api_key_aqui
EMAIL_FROM=turnos@agendaste.com.ar

# Puerto
PORT=3000
